# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://olive:YOUR_PASSWORD@postgres:5432/olive_labs"

# ── Redis ──
REDIS_URL="redis://redis:6379"

# ── MinIO (S3-compatible storage) ──
# All MINIO_* vars below are REQUIRED in production.
# In development they fall back to local MinIO with the literals here, but the
# server WILL throw at boot if any of MINIO_ENDPOINT / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY is missing while NODE_ENV=production.
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minio_access_key"
MINIO_SECRET_KEY="YOUR_MINIO_SECRET"
MINIO_USE_SSL=false
MINIO_BUCKET_PDFS="propostas-pdf"
MINIO_BUCKET_ATTACHMENTS="attachments"
MINIO_BUCKET_LOGOS="logos"

# ── NextAuth ──
# REQUIRED. Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="generate-a-random-secret-min-32-chars"
NEXTAUTH_URL="https://your-domain.com"
# Optional: only needed if NEXTAUTH_URL isn't reachable from the email worker.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── SMTP (transactional email: invites, password reset, proposal send) ──
# Without these, sendMail() returns false silently — no emails are dispatched.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Olive Labs <no-reply@olivecomunicacao.com.br>"

# ── Database seed ──
# REQUIRED in production. The seed script will refuse to create the super-admin
# users without these. In development it generates a random password and prints
# it to the console once.
SEED_ADMIN_ELLO_PASSWORD=""
SEED_ADMIN_OLIVE_PASSWORD=""

# ── Cron ──
# Bearer token for /api/cron/expire-proposals. Required if you wire a scheduler
# (EasyPanel HTTP cron, GitHub Actions, etc.) to call that endpoint.
CRON_SECRET=""

# ── Off-site backup (read by ol-backup container + /api/health) ──
# When configured, the daily `scripts/backup.sh` dumps Postgres + mirrors MinIO
# to this S3-compatible bucket and writes a daily heartbeat. /api/health then
# surfaces backupStatus = fresh | stale | unknown | error.
#
# Use a key scoped to PutObject ONLY (write-only). Object-Lock the bucket for
# 30 days so a host compromise cannot delete past backups. See
# docs/BACKUP_DR_AUDIT.md § R2/R3 and docs/RESTORE_RUNBOOK.md.
OFFSITE_S3_ENDPOINT=""        # e.g. https://s3.us-west-002.backblazeb2.com
OFFSITE_S3_KEY=""
OFFSITE_S3_SECRET=""
OFFSITE_BUCKET=""             # e.g. ol-backups
# Optional: GPG-encrypt dumps before upload. Keep this passphrase OUTSIDE
# EasyPanel (team password manager) so a host compromise cannot decrypt.
BACKUP_GPG_PASSPHRASE=""
BACKUP_RETENTION_DAYS=30
